 *
 * Both roles of the one controller; CONFIG_PCIE_ROLE picks at boot.
 */

/ {
	aliases {
		watchdog0 = &wdt0;
	};

	chosen {
		zephyr,pcie-controller = &pcie0;
	};
};

/* resets the board when the image hangs (task watchdog in main.c) */
&wdt0 {
	status = "okay";
};

&pcie0 {
	status = "okay";
};

&pcie0_ep {
	/* Gen2 over the crossover cable drops the data link every few hundred
	 * ms, and every drop resets the configuration space (BARs, VFs) */
	max-link-speed = <1>;
	vendor-id = <0x1d87>;
	device-id = <0x3399>;
	class-code = <0xff0000>;
	msi-vectors = <16>;
	status = "okay";

	epf_test0: function@0 {
		compatible = "zephyr,pcie-epf-test";
		reg = <0>;
		vendor-id = <0x1d87>;
		device-id = <0x3399>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-size = <0x2000000>;
		/* BAR0 registers, 64-bit BARs need even numbers: 32-bit here */
		bar-sizes = <8192 65536 0 0 0x100000 0>;
		/*
		 * BAR4 (with BAR5, 64-bit prefetchable) resizable 1..16 MiB;
		 * BAR0 and BAR1 then grow to 1 MiB, the doorbell block too
		 */
		resizable-bar = <4>;
		resizable-bar-max-size = <0x1000000>;
		msi-interrupts = <16>;
		/* table and PBA after the register block in BAR0 */
		msix-interrupts = <16>;
	};
};

/*
 * SR-IOV: 8 VFs (routing functions 1..8, the most the core has), each a
 * pcie_epf_test with its own 4 MiB of the carveout after the PF's 32 MiB.
 * The VF BAR layout is shared, so bar-sizes match; BAR4 is left out, so all
 * 8 VFs take 576 KiB of non-prefetchable window next to the PF's 2 MiB.
 * VF 8 has routing ID 8, device 1 without ARI: the host reaches it only if
 * the downstream port above forwards ARI (DevCap2 ARIFwd+); otherwise 7 VFs.
 * Host: pcictl sriov <bdf> 8 (or echo 8 > /sys/bus/pci/devices/<bdf>/sriov_numvfs)
 */
&pcie0_ep {
	max-virtual-functions = <8>;

	epf_test_vf1: function@1 {
		compatible = "zephyr,pcie-epf-test";
		reg = <1>;
		vendor-id = <0x1d87>;
		device-id = <0x339a>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-offset = <0x2000000>;
		memory-size = <0x400000>;
		bar-sizes = <8192 65536 0 0 0 0>;
		msi-interrupts = <4>;
		msix-interrupts = <4>;
	};

	epf_test_vf2: function@2 {
		compatible = "zephyr,pcie-epf-test";
		reg = <2>;
		vendor-id = <0x1d87>;
		device-id = <0x339a>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-offset = <0x2400000>;
		memory-size = <0x400000>;
		bar-sizes = <8192 65536 0 0 0 0>;
		msi-interrupts = <4>;
		msix-interrupts = <4>;
	};

	epf_test_vf3: function@3 {
		compatible = "zephyr,pcie-epf-test";
		reg = <3>;
		vendor-id = <0x1d87>;
		device-id = <0x339a>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-offset = <0x2800000>;
		memory-size = <0x400000>;
		bar-sizes = <8192 65536 0 0 0 0>;
		msi-interrupts = <4>;
		msix-interrupts = <4>;
	};

	epf_test_vf4: function@4 {
		compatible = "zephyr,pcie-epf-test";
		reg = <4>;
		vendor-id = <0x1d87>;
		device-id = <0x339a>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-offset = <0x2c00000>;
		memory-size = <0x400000>;
		bar-sizes = <8192 65536 0 0 0 0>;
		msi-interrupts = <4>;
		msix-interrupts = <4>;
	};

	epf_test_vf5: function@5 {
		compatible = "zephyr,pcie-epf-test";
		reg = <5>;
		vendor-id = <0x1d87>;
		device-id = <0x339a>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-offset = <0x3000000>;
		memory-size = <0x400000>;
		bar-sizes = <8192 65536 0 0 0 0>;
		msi-interrupts = <4>;
		msix-interrupts = <4>;
	};

	epf_test_vf6: function@6 {
		compatible = "zephyr,pcie-epf-test";
		reg = <6>;
		vendor-id = <0x1d87>;
		device-id = <0x339a>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-offset = <0x3400000>;
		memory-size = <0x400000>;
		bar-sizes = <8192 65536 0 0 0 0>;
		msi-interrupts = <4>;
		msix-interrupts = <4>;
	};

	epf_test_vf7: function@7 {
		compatible = "zephyr,pcie-epf-test";
		reg = <7>;
		vendor-id = <0x1d87>;
		device-id = <0x339a>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-offset = <0x3800000>;
		memory-size = <0x400000>;
		bar-sizes = <8192 65536 0 0 0 0>;
		msi-interrupts = <4>;
		msix-interrupts = <4>;
	};

	epf_test_vf8: function@8 {
		compatible = "zephyr,pcie-epf-test";
		reg = <8>;
		vendor-id = <0x1d87>;
		device-id = <0x339a>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-offset = <0x3c00000>;
		memory-size = <0x400000>;
		bar-sizes = <8192 65536 0 0 0 0>;
		msi-interrupts = <4>;
		msix-interrupts = <4>;
	};
};
