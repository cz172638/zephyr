 *
 * Both roles of the one controller; CONFIG_PCIE_ROLE picks at boot.
 */

/ {
	chosen {
		zephyr,pcie-controller = &pcie0;
	};
};

&pcie0 {
	status = "okay";
};

&pcie0_ep {
	/* Gen2 over the crossover cable drops the data link every few hundred
	 * ms, and every drop resets the configuration space (BARs, VFs) */
	max-link-speed = <1>;
	vendor-id = <0x1d87>;
	device-id = <0x3399>;
	class-code = <0xff0000>;
	msi-vectors = <16>;
	status = "okay";

	epf_test0: function@0 {
		compatible = "zephyr,pcie-epf-test";
		reg = <0>;
		vendor-id = <0x1d87>;
		device-id = <0x3399>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-size = <0x400000>;
		/* BAR0 registers, 64-bit BARs need even numbers: 32-bit here */
		bar-sizes = <8192 65536 0 0 0x100000 0>;
		msi-interrupts = <16>;
	};
};

/* SD slot host kept for its JTAG handling (force_jtag), no card disk */
&sdmmc_disk {
	status = "disabled";
};

/*
 * SR-IOV: 4 VFs (routing functions 1..4), each a pcie_epf_test with its own
 * 4 MiB of the carveout. The VF BAR layout is shared, so bar-sizes match;
 * BAR4 is left out so 4 VFs fit a 2 MiB bridge window next to the PF.
 * Host: echo 4 > /sys/bus/pci/devices/<bdf>/sriov_numvfs
 */
&pcie0_ep {
	max-virtual-functions = <4>;

	epf_test_vf1: function@1 {
		compatible = "zephyr,pcie-epf-test";
		reg = <1>;
		vendor-id = <0x1d87>;
		device-id = <0x339a>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-offset = <0x400000>;
		memory-size = <0x400000>;
		bar-sizes = <8192 65536 0 0 0 0>;
		msi-interrupts = <4>;
	};

	epf_test_vf2: function@2 {
		compatible = "zephyr,pcie-epf-test";
		reg = <2>;
		vendor-id = <0x1d87>;
		device-id = <0x339a>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-offset = <0x800000>;
		memory-size = <0x400000>;
		bar-sizes = <8192 65536 0 0 0 0>;
		msi-interrupts = <4>;
	};

	epf_test_vf3: function@3 {
		compatible = "zephyr,pcie-epf-test";
		reg = <3>;
		vendor-id = <0x1d87>;
		device-id = <0x339a>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-offset = <0xc00000>;
		memory-size = <0x400000>;
		bar-sizes = <8192 65536 0 0 0 0>;
		msi-interrupts = <4>;
	};

	epf_test_vf4: function@4 {
		compatible = "zephyr,pcie-epf-test";
		reg = <4>;
		vendor-id = <0x1d87>;
		device-id = <0x339a>;
		class-code = <0xff0000>;
		memory-region = <&pcie_ep_mem>;
		memory-offset = <0x1000000>;
		memory-size = <0x400000>;
		bar-sizes = <8192 65536 0 0 0 0>;
		msi-interrupts = <4>;
	};
};
