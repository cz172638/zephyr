source "Kconfig.zephyr"

if SSH_SERVER

config PCIE_SHELL_SSH_USERNAME
	string "SSH user name (empty: any)"
	default "root"

config PCIE_SHELL_SSH_PASSWORD
	string "SSH password"
	default ""
	help
	  Stored in clear text in the image. Empty: the server is not
	  started.

config PCIE_SHELL_SSH_HOST_KEY_BITS
	int "RSA host key size"
	default 2048
	help
	  Generated on the first boot and kept in the settings file on the
	  eMMC FAT; without it, a new key (and fingerprint) on every boot.

endif
