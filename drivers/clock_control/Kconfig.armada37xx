config CLOCK_CONTROL_ARMADA37XX_PERIPH
	bool "Marvell Armada 37xx TBG and peripheral clocks"
	default y
	depends on DT_HAS_MARVELL_ARMADA_3700_PERIPH_CLOCK_SB_ENABLED || \
		   DT_HAS_MARVELL_ARMADA_3700_PERIPH_CLOCK_NB_ENABLED || \
		   DT_HAS_MARVELL_ARMADA_3700_TBG_CLOCK_ENABLED
	help
	  Gates of the north/south bridge peripheral clocks and read-only
	  rates of the TBG PLLs, muxes and dividers.
