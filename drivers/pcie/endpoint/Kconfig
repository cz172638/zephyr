# PCIe Endpoint configuration options

# Copyright 2020 Broadcom
# SPDX-License-Identifier: Apache-2.0

menuconfig PCIE_ENDPOINT
	bool "PCIe Endpoint support"
	help
	  This option enables PCIe Endpoint support.

if PCIE_ENDPOINT

module = PCIE_EP
module-str = PCIE_EP
source "subsys/logging/Kconfig.template.log_config"

comment "Legacy PCIe Endpoint API (pcie_ep.h)"

source "drivers/pcie/endpoint/Kconfig.iproc"
source "drivers/pcie/endpoint/Kconfig.rk3399"

comment "Endpoint Controller / Endpoint Function API (pcie_epc.h, pcie_epf.h)"

config PCIE_EPC
	bool "Endpoint controller core"
	help
	  Hardware independent part of the split endpoint stack: function
	  bookkeeping, outbound window allocator, event delivery and link
	  autostart. Selected by EPC controller drivers.

if PCIE_EPC

config PCIE_EPC_INIT_PRIORITY
	int "Endpoint controller init priority"
	default 70
	help
	  POST_KERNEL priority of EPC controller drivers. Must be after the
	  firmware (TISCI), power domain and syscon drivers.

config PCIE_EPF_DEFAULT_FUNCTION
	string "Endpoint function that binds when none is saved"
	default ""
	help
	  Name of the function ("test", "nvme", "vntb", ...) that claims the
	  controller when the setting pcie/ep/func is not set; empty: the
	  first function in devicetree order. "pcie controller ep function"
	  saves another one for the next boot.

config PCIE_EPF_INIT_PRIORITY
	int "Endpoint function init priority"
	default 75
	help
	  POST_KERNEL priority of EPF drivers, after PCIE_EPC_INIT_PRIORITY.

config PCIE_EPC_AUTOSTART_PRIORITY
	int "Endpoint link autostart priority"
	default 90 if PCIE_EPC_DSN_SETTINGS
	default 80
	help
	  POST_KERNEL priority at which controllers with at least one bound
	  function start link training. After PCIE_EPF_INIT_PRIORITY.

config PCIE_EPC_DSN_SETTINGS
	bool "Device Serial Number kept in settings"
	depends on SETTINGS
	help
	  Generate a locally administered EUI-64 on the first boot, keep it
	  in settings (pcie/ep/dsn<n>) and program it into every endpoint
	  controller with a DSN capability before link autostart, as the
	  netshell does with its MAC addresses. A root port driver keeps its
	  own (pcie/rc/dsn<n>). Shell: pcie controller dsn.

config PCIE_EPC_DSN_SPI_NOR_UID
	bool "First DSN from the SPI NOR unique ID"
	default y
	depends on PCIE_EPC_DSN_SETTINGS && SPI_NOR
	select FLASH_EX_OP_ENABLED
	help
	  On the first boot (nothing in settings) the DSN is made from the
	  64-bit factory unique ID of the SPI NOR (command 0x4B), with the
	  locally administered bit set; random without it.

config PCIE_EPC_DSN_POLL_MS
	int "Poll for a DSN written by the host [ms]"
	default 1000
	depends on PCIE_EPC_DSN_SETTINGS
	help
	  Some controllers let the host write the DSN capability (setpci
	  ECAP_DSN+4.l=... ECAP_DSN+8.l=...). A changed value is saved to
	  settings. 0 disables the poll.

config PCIE_EPC_DSN_INIT_PRIORITY
	int "DSN init priority"
	default 85
	depends on PCIE_EPC_DSN_SETTINGS
	help
	  POST_KERNEL priority: after the settings flash (SPI_NOR_INIT_PRIORITY)
	  and the controllers, before PCIE_EPC_AUTOSTART_PRIORITY.

config PCIE_EPC_OB_PAGES
	int "Outbound window allocator granules"
	default 64
	range 8 1024
	help
	  Number of allocation units the outbound window is split into. The
	  granule grows (power of two, min 4 KiB) until the window fits.

config PCIE_EPC_EVENT_QUEUE_DEPTH
	int "Pending controller events"
	default 16

endif # PCIE_EPC

source "drivers/pcie/endpoint/Kconfig.aardvark"

source "drivers/pcie/endpoint/functions/Kconfig"

endif # PCIE_ENDPOINT
