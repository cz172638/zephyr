config PCIE_EPC_AARDVARK
	bool "Marvell Armada 3700 (Aardvark) endpoint controller"
	default y
	depends on DT_HAS_MARVELL_ARMADA_3700_PCIE_EP_ENABLED
	depends on ARM64
	select PCIE_EPC
	help
	  The Armada 3700 PCIe controller in endpoint mode, its reset
	  default. Header, outbound windows, MSI and link events; BAR
	  sizing and inbound translation are undocumented and left at the
	  reset defaults.

if PCIE_EPC_AARDVARK

config PCIE_EPC_AARDVARK_INBOUND_LIMIT
	hex "Inbound window (host access to DDR from 0)"
	default 0x40000
	help
	  The BARs land on DDR from address 0 (BAR offset = DDR address).
	  The PCIe IO decode window is shrunk to this size so the host
	  cannot reach anything above; the BAR backing store has to be there
	  and BL33 above it (TF-A A3700_NS_IMAGE_OFFSET). 0 keeps TF-A's
	  window (all of DRAM).

config PCIE_EPC_AARDVARK_POLL_MS
	int "Link poll period [ms]"
	default 20
	help
	  The controller interrupt sources of endpoint mode are not known,
	  link state, bus master enable and PERST# are polled.

config PCIE_EPC_AARDVARK_TRACE_INIT
	bool "printk checkpoints in the driver init"
	help
	  For bring-up: shows how far the init got when it hangs before the
	  console (deferred) log comes out.

config PCIE_EPC_AARDVARK_SHELL
	bool "Bring-up shell (advk_ep)"
	default y
	depends on SHELL
	help
	  Register dumps, writable bit probing, LTSSM tracing, INTx/MSI
	  and host memory access through an outbound window.

endif # PCIE_EPC_AARDVARK
