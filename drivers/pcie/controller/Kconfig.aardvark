config PCIE_AARDVARK
	bool "Marvell Armada 3700 (Aardvark) PCIe root complex"
	default y
	depends on DT_HAS_MARVELL_ARMADA_3700_PCIE_ENABLED
	depends on ARM64
	select FLASH_EX_OP_ENABLED if SPI_NOR
	help
	  The Armada 3700 PCIe controller as root complex: configuration
	  requests through the PIO block, a software root port with the
	  hardware's PCIe and extended capabilities (AER, L1SS, LTR) passed
	  through, outbound windows from "ranges", generic enumeration.

if PCIE_AARDVARK

config PCIE_AARDVARK_INIT_PRIORITY
	int "POST_KERNEL init priority"
	default 84
	help
	  After the GPIO, clock and (with PCIE_AARDVARK_MODE) the settings
	  that choose the role.

config PCIE_AARDVARK_CORE_TIMEOUT_MS
	int "Wait for the core registers after the PHY [ms]"
	default 500
	help
	  The core control registers abort for some time after the clock
	  and the COMPHY are switched on.

config PCIE_AARDVARK_PERST_MS
	int "PERST# pulse [ms]"
	default 10

config PCIE_AARDVARK_LINK_TIMEOUT_MS
	int "Wait for the link [ms]"
	default 1000

config PCIE_AARDVARK_CRS_TIMEOUT_MS
	int "Retry a configuration request answered with CRS for, ms"
	default 1000
	help
	  A device still initialising (a switch loading its EEPROM) answers
	  configuration requests with Configuration Request Retry Status.
	  The base specification allows 1 s after a reset; the request is
	  repeated every millisecond for that long, then the function is
	  taken as absent.

config PCIE_AARDVARK_TRACE_INIT
	bool "printk checkpoints in the init"
	help
	  Prints the core control registers after every bring-up step. A
	  step whose registers abort is reported and stops the init
	  in any case.

config PCIE_AARDVARK_AER
	bool "Advanced Error Reporting"
	default y
	depends on PCIE_CONTROLLER
	select PCIE_AER
	help
	  After every enumeration, error reporting on the whole tree (see
	  PCIE_AER); error messages at the root port (ISR0 bits 11-13) are
	  serviced from the system work queue and logged with the source.

config PCIE_AARDVARK_SHELL
	bool "pcie shell backend and debug commands"
	default y
	depends on PCIE_CTRL_SHELL

config PCIE_AARDVARK_EPFTEST_SHELL
	bool "pcie debug epftest: host side of the endpoint test function"
	default y
	depends on PCIE_AARDVARK_SHELL
	select CRC
	help
	  BAR patterns, MSI/MSI-X into the root complex's MSI receiver and
	  read/write/copy into RC memory against a pci-epf-test compatible
	  endpoint (Zephyr pcie_epf_test, Linux pci-epf-test), as pcitest.

config PCIE_AARDVARK_EPFTEST_BUF_KB
	int "Host buffers (two) for epftest, KiB"
	default 1024
	depends on PCIE_AARDVARK_EPFTEST_SHELL

config PCIE_AARDVARK_NVME_SHELL
	bool "pcie debug nvme: polled NVMe identify and read"
	default y
	depends on PCIE_AARDVARK_SHELL
	help
	  Bring-up check of both directions through the controller without
	  interrupts or a disk driver.

endif # PCIE_AARDVARK
