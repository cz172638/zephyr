# PCIe RC/EP drivers configuration options

config PCIE_AARDVARK_MODE
	bool "Armada 3700 PCIe: root complex or endpoint from settings"
	default y
	depends on DT_HAS_MARVELL_ARMADA_3700_PCIE_ENABLED
	depends on DT_HAS_MARVELL_ARMADA_3700_PCIE_EP_ENABLED
	depends on SETTINGS
	help
	  With both the root complex and the endpoint driver built in, the
	  setting "advk/mode" ("rc" or "ep") picks the role at boot;
	  "pcie controller mode rc|ep" in the shell stores it for the next
	  boot. The
	  driver not picked leaves the controller alone.

if PCIE_AARDVARK_MODE

config PCIE_AARDVARK_MODE_DEFAULT_RC
	bool "Root complex when nothing is saved"
	help
	  Without it the controller stays an endpoint, its reset role.

config PCIE_AARDVARK_MODE_INIT_PRIORITY
	int "POST_KERNEL priority of the mode lookup"
	default 81
	help
	  After the settings flash (SPI_NOR_INIT_PRIORITY), before both
	  controller drivers.

# Both controller drivers after the mode lookup
configdefault PCIE_EPC_INIT_PRIORITY
	default 82

configdefault PCIE_EPF_INIT_PRIORITY
	default 83

endif # PCIE_AARDVARK_MODE

config PCIE_ROLE
	bool "Dual-mode PCIe controller: root complex or endpoint at boot"
	default y
	depends on DT_HAS_ROCKCHIP_RK3399_PCIE_ENABLED && DT_HAS_ROCKCHIP_RK3399_PCIE_EP_ENABLED
	help
	  With both the root complex and the endpoint driver of a dual-mode
	  controller built in, pick the role at boot (see
	  zephyr/drivers/pcie/role.h); "pcie controller mode rc|ep" stores
	  it for the next boot.

if PCIE_ROLE

config PCIE_ROLE_DEFAULT_RC
	bool "Root complex when nothing is saved"

config PCIE_ROLE_SETTINGS
	bool "Keep the role in settings"
	depends on SETTINGS

config PCIE_ROLE_RETENTION_REG
	hex "Keep the role in this register (survives warm reset), 0 = nowhere"
	default 0xff320304 if SOC_RK3399
	default 0
	help
	  RK3399: PMUGRF_OS_REG1 (OS_REG0 is the boot mode register, OS_REG2/3
	  hold the DRAM configuration). Written on every save; read when
	  settings have no role or are unavailable.

config PCIE_ROLE_INIT_PRIORITY
	int "POST_KERNEL priority of the role lookup"
	default 81

configdefault PCIE_EPC_INIT_PRIORITY
	default 82

configdefault PCIE_EPF_INIT_PRIORITY
	default 83

# the link autostart walks the registered controllers: after them
configdefault PCIE_EPC_AUTOSTART_PRIORITY
	default 90 if PCIE_EPC_DSN_SETTINGS
	default 85

endif # PCIE_ROLE

config PCIE_RK3399_PORT
	bool
	help
	  RK3399 PCIe bring-up shared by the root complex and the endpoint
	  driver: clocks, resets, client wrapper, PHY.

source "drivers/pcie/host/Kconfig"
source "drivers/pcie/endpoint/Kconfig"
source "drivers/pcie/controller/Kconfig"
source "drivers/pcie/fabric/Kconfig"

config PCIE_AER
	bool "Advanced Error Reporting below a root port"
	depends on PCIE_CONTROLLER
	help
	  Controller neutral helpers: walk the tree under a root port, enable
	  error reporting and forwarding on every function, service the root
	  port's received error messages and count them per source. Used by
	  root complex drivers after the enumeration; "pcie aer" in the
	  shell.

config PCIE_AER_SOURCES
	int "Error sources counted"
	default 16
	depends on PCIE_AER

config PCIE_AER_UR_EP
	bool "Unsupported Request reporting on endpoints"
	default y
	depends on PCIE_AER

config PCIE_AER_UR_BRIDGE
	bool "Unsupported Request reporting on ports and bridges"
	depends on PCIE_AER
	help
	  Off by default: config reads of absent functions below a port end
	  with UR, every rescan would report.

config PCIE_AER_ECRC
	bool "ECRC generation and check where capable"
	depends on PCIE_AER
	help
	  End-to-end CRC (TLP digest). Switches pass it through; both ends
	  have to be capable for a check to mean anything.

config PCIE_AER_LOG_LIMIT
	int "Messages logged per source (then counted only)"
	default 16
	depends on PCIE_AER

config PCIE_CTRL_SHELL
	bool "Controller-neutral pcie shell"
	default y
	depends on SHELL
	depends on PCIE_CONTROLLER || PCIE_EPC
	depends on !PCIE_SHELL
	help
	  "pcie controller | ls | cfg | cap | debug": the same commands for
	  root complex and endpoint controllers of any vendor; the drivers
	  register a backend (pcie_shell_register()). Replaces the generic
	  PCIE_SHELL, which uses the same command name.
