config MBOX_MVEBU_RWTM
	bool "Marvell Armada 3700 rWTM mailbox"
	default y
	depends on DT_HAS_MARVELL_ARMADA_3700_RWTM_MAILBOX_ENABLED || \
		   DT_HAS_MARVELL_ARMADA_3700_RWTM_SP_ENABLED
	help
	  Mailbox between the A53 cores and the Cortex-M3 secure processor
	  of the Armada 3700, both ends. Used as the doorbell of the icmsg
	  IPC backend; the WTMI firmware commands (below 0x200) stay
	  compatible.
