CONFIG_ARMV8_A_NS=y
CONFIG_CACHE_MANAGEMENT=y
CONFIG_TICKLESS_KERNEL=y

CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

CONFIG_PM_CPU_OPS_PSCI=y

# sys_reboot() through PSCI SYSTEM_RESET (BL31: R_WDOG reset)
CONFIG_REBOOT=y

# both clusters: 8x Cortex-A55
CONFIG_SMP=y
CONFIG_MP_MAX_NUM_CPUS=8

# optional SPI NOR on SPI0: geometry from SFDP, as the part varies
CONFIG_FLASH=y
CONFIG_SPI=y
CONFIG_SPI_NOR=y
CONFIG_SPI_NOR_SFDP_RUNTIME=y
CONFIG_FLASH_MAP=y
