#include <allwinner/sun55i-a523.dtsi>

/ {
	model = "Radxa Cubie A5E";
	compatible = "radxa,cubie-a5e", "allwinner,sun55i-a527", "allwinner,sun55i-a523";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &dram0;
	};

	/*
	 * TF-A BL31 runs from SRAM A2 and enters BL33 at 0x4a000000
	 * (PRELOADED_BL33_BASE). 512 MiB fit every memory option of the board.
	 */
	dram0: memory@4a000000 {
		compatible = "mmio-sram";
		device_type = "memory";
		reg = <0x4a000000 DT_SIZE_M(512)>;
	};
};

/* 40-pin header pins 8 (TX) and 10 (RX): PB9/PB10, muxed by U-Boot SPL */
&uart0 {
	current-speed = <115200>;
	status = "okay";
};

/*
 * 16 MiB SPI NOR flash on SPI0 (pins PC2, PC3, PC4 and PC12, single-bit
 * mode). On boards populated with eMMC the HOLD and WP signals of the
 * flash are not wired, which rules out dual/quad transfers.
 */
&spi0 {
	status = "okay";

	flash0: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(24)>;
		size = <DT_SIZE_M(128)>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* the eGON SPL + U-Boot FIT image flashed at offset 0 */
			boot_partition: partition@0 {
				label = "boot";
				reg = <0x0 0x100000>;
			};

			storage_partition: partition@100000 {
				label = "storage";
				reg = <0x100000 0xf00000>;
			};
		};
	};
};
