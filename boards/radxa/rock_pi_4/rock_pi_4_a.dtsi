#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm64.h>
#include "rock_pi_4_memory.dtsi"

/ {
	model = "Radxa ROCK Pi 4";
	compatible = "radxa,rock-pi-4", "rockchip,rk3399";

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart2;
		zephyr,shell-uart = &uart2;
	};

	shm: memory@6200000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <ROCK_PI_4_SHM_BASE ROCK_PI_4_SHM_SIZE>;
		zephyr,memory-region = "SHM";
		zephyr,memory-attr = <DT_MEM_ARM64_MMU_NORMAL_NC>;
	};

	pcie_ep_mem: memory@8000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <ROCK_PI_4_PCIE_EP_BASE ROCK_PI_4_PCIE_EP_SIZE>;
		zephyr,memory-region = "PCIE_EP";
		zephyr,memory-attr = <DT_MEM_ARM64_MMU_NORMAL_NC>;
	};
};

&uart2 {
	current-speed = <1500000>;
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio4 {
	status = "okay";
};

/*
 * M.2 M-key slot. In endpoint mode the host drives PERST# on GPIO4_D3 (the
 * "ep-gpios" line of root complex mode) and the slot 3.3 V supply
 * (vcc3v3_pcie, GPIO2_D2) must stay off. The RK3399 PHY has no reference
 * clock input, so the host must accept a separate reference clock.
 */
&pcie0_ep {
	perst-gpios = <&gpio4 27 GPIO_ACTIVE_LOW>;
	slot-power-gpios = <&gpio2 26 GPIO_ACTIVE_HIGH>;
	num-lanes = <4>;
	max-link-speed = <2>;
};

/* Root complex role: PERST# and the slot 3.3 V are ours to drive */
&pcie0 {
	perst-gpios = <&gpio4 27 GPIO_ACTIVE_LOW>;
	slot-power-gpios = <&gpio2 26 GPIO_ACTIVE_HIGH>;
	num-lanes = <4>;
	max-link-speed = <2>;
};

/*
 * SPI flash on SPI1 (4A+/4B+/4C, v1.4+; absent on older boards, then the
 * flash device just fails to come up). SPI1 shares GPIO1_A7/B0 with UART4.
 * Layout as rk3399-image.pl writes it; 4 MiB parts at least.
 */
&spi1 {
	pinctrl-0 = <&spi1_pins>;
	pinctrl-names = "default";
	clock-frequency = <DT_FREQ_K(99000)>;
	status = "okay";

	spi_flash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_K(24750)>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			idbloader_partition: partition@0 {
				label = "idbloader";
				reg = <0x0 0xe0000>;
				read-only;
			};

			fit_partition: partition@e0000 {
				label = "fit";
				reg = <0xe0000 0x220000>;
			};

			storage_partition: partition@300000 {
				label = "storage";
				reg = <0x300000 0x100000>;
			};
		};
	};
};

/*
 * micro SD, 3.3 V, up to high speed. The slot doubles as JTAG (breakout):
 * no card -> JTAG by force_jtag, breakout seen as a card -> JTAG by iomux.
 */
&sdmmc {
	pinctrl-0 = <&sdmmc_pins>;
	pinctrl-names = "default";
	bus-width = <4>;
	rockchip,sd-jtag;
	status = "okay";

	sdmmc_disk: sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

/*
 * eMMC module: boot medium (idbloader sector 64, FIT sector 2048) and
 * storage (FAT partition from 16 MiB: settings, LLEXT, images).
 */
&sdhci {
	bus-width = <8>;
	status = "okay";

	emmc_disk: emmc {
		compatible = "zephyr,mmc-disk";
		disk-name = "EMMC";
		bus-width = <8>;
		status = "okay";
	};
};
