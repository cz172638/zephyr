config BOARD_ROCK_PI_4
	select SOC_RK3399_A53 if BOARD_ROCK_PI_4_RK3399_A53 || BOARD_ROCK_PI_4_RK3399_A53_SMP
	select SOC_RK3399_A72 if BOARD_ROCK_PI_4_RK3399_A72 || BOARD_ROCK_PI_4_RK3399_A72_SMP
	select SOC_RK3399_M0_PMU if BOARD_ROCK_PI_4_RK3399_M0_PMU
	select SOC_RK3399_M0_PERILP if BOARD_ROCK_PI_4_RK3399_M0_PERILP
