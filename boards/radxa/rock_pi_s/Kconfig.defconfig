if BOARD_ROCK_PI_S

if NETWORKING

configdefault ETH_DRIVER
	default y

# RX buffers must be a multiple of the 64-byte cache line (DWMAC DMA)
configdefault NET_BUF_DATA_SIZE
	default 1536 if NET_BUF_FIXED_DATA_SIZE

endif # NETWORKING

endif # BOARD_ROCK_PI_S
