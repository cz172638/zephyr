#include <rockchip/rk3308.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/rk3308-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	compatible = "radxa,rock-pi-s", "rockchip,rk3308";

	vdd_core: regulator-vdd-core {
		compatible = "pwm-regulator";
		pwms = <&pwm0 0 PWM_NSEC(5000) PWM_POLARITY_INVERTED>;
		regulator-name = "vdd_core";
		regulator-min-microvolt = <827000>;
		regulator-max-microvolt = <1340000>;
		regulator-settling-time-up-us = <250>;
		regulator-always-on;
		regulator-boot-on;
	};

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	/*
	 * DDR layout when booting straight from BL31 (ROCK Pi S, 256 MiB min):
	 *   0x00000000-0x000fffff BL31, DDR firewall region 0 (secure)
	 *   0x02000000-0x02ffffff Zephyr (below)
	 * No OP-TEE and no U-Boot proper are loaded.
	 */
	sram0: memory@2000000 {
		device_type = "memory";
		reg = <0x02000000 DT_SIZE_M(16)>;
	};

	/* Informational: BL31's secure carve-out, kept clear of Zephyr */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		bl31@0 {
			reg = <0x00000000 DT_SIZE_M(1)>;
			no-map;
		};
	};
};

&pinctrl {
	pwm0_default: pwm0-default {
		group1 {
			pinmux = <PWM0>;
			bias-disable;
		};
	};

	/* micro SD: no pull-ups on the board, card detect on GPIO0_A3 */
	sdmmc_default: sdmmc-default {
		group1 {
			pinmux = <SDMMC_D0>, <SDMMC_D1>, <SDMMC_D2>, <SDMMC_D3>, <SDMMC_CMD>,
				 <SDMMC_DET>;
			bias-pull-up;
		};

		group2 {
			pinmux = <SDMMC_CLK>;
			bias-disable;
		};
	};

	uart0_default: uart0-default {
		group1 {
			pinmux = <UART0_RX_M0>, <UART0_TX_M0>;
		};
	};

	/* header pins 23 (RX) and 24 (TX) */
	uart1_default: uart1-default {
		group1 {
			pinmux = <UART1_RX>, <UART1_TX>;
		};
	};

	/* header pins 21 (RX) and 19 (TX) */
	uart2_default: uart2-default {
		group1 {
			pinmux = <UART2_RX_M0>, <UART2_TX_M0>;
		};
	};

	/* header pins 40 (RX) and 39 (TX) */
	uart3_default: uart3-default {
		group1 {
			pinmux = <UART3_RX_M0>, <UART3_TX_M0>;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <1500000>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
};

/* RTL8201F on RMII, 50 MHz reference generated by the SoC */
&mac {
	status = "okay";
	clock-in-out = "output";
	phy-handle = <&rtl8201f>;
};

/*
 * vdd_core (CPU cores): buck set by PWM0 (inverted, 200 kHz), 0.827 V to
 * 1.34 V, as in the Linux devicetree. Until a voltage is set the pin stays
 * a GPIO input and the buck runs at its strapped voltage.
 */
&pwm0 {
	pinctrl-0 = <&pwm0_default>;
	pinctrl-names = "default";
	status = "okay";
};

&sdmmc {
	pinctrl-0 = <&sdmmc_default>;
	pinctrl-names = "default";
	bus-width = <4>;
	status = "okay";

	sdmmc_disk: sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
		status = "okay";
	};
};

/* CPU ID: the MAC address derived from it */
&otp {
	status = "okay";
};

&mdio {
	status = "okay";

	rtl8201f: ethernet-phy@1 {
		compatible = "ethernet-phy";
		reg = <1>;
		/* GPIO0_A7, iomux defaults to GPIO */
		reset-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
		reset-assert-us = <20000>;
		reset-deassert-us = <50000>;
		default-speeds = "10BASE Half-Duplex", "10BASE Full-Duplex",
				 "100BASE Half-Duplex", "100BASE Full-Duplex";
	};
};

/* USB-C: OTG port, also the power input */
zephyr_udc0: &usb20_otg {
	status = "okay";
};

