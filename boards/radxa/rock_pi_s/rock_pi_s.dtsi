#include <rockchip/rk3308.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	compatible = "radxa,rock-pi-s", "rockchip,rk3308";

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	/*
	 * DDR layout of the boot chain (ROCK Pi S, 256 MiB minimum):
	 *   0x00000000-0x000fffff BL31, DDR firewall region 0 (secure)
	 *   0x00200000-...        U-Boot proper, load addresses up to 0x0a000000
	 *   0x02000000-0x02ffffff Zephyr (below)
	 *   0x0a000000-0x0affffff OP-TEE TZDRAM, firewall region 1 (secure)
	 *   0x0b000000-0x0b3fffff OP-TEE SHMEM
	 *   ~0x0cf00000-top       U-Boot after relocation (LMB)
	 */
	sram0: memory@2000000 {
		device_type = "memory";
		reg = <0x02000000 DT_SIZE_M(16)>;
	};

	/* Same carve-outs as the U-Boot/Linux -optee overlay; informational */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		bl31@0 {
			reg = <0x00000000 DT_SIZE_M(1)>;
			no-map;
		};

		optee_core@a000000 {
			reg = <0x0a000000 DT_SIZE_M(16)>;
			no-map;
		};

		optee_shm@b000000 {
			reg = <0x0b000000 DT_SIZE_M(4)>;
			no-map;
		};
	};
};

&optee {
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <1500000>;
};

&gpio0 {
	status = "okay";
};

/* RTL8201F on RMII, 50 MHz reference generated by the SoC */
&mac {
	status = "okay";
	clock-in-out = "output";
	phy-handle = <&rtl8201f>;
	zephyr,random-mac-address;
};

&mdio {
	status = "okay";

	rtl8201f: ethernet-phy@1 {
		compatible = "ethernet-phy";
		reg = <1>;
		/* GPIO0_A7, iomux defaults to GPIO */
		reset-gpios = <&gpio0 7 GPIO_ACTIVE_LOW>;
		reset-assert-us = <20000>;
		reset-deassert-us = <50000>;
		default-speeds = "10BASE Half-Duplex", "10BASE Full-Duplex",
				 "100BASE Half-Duplex", "100BASE Full-Duplex";
	};
};
