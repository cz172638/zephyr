# Runs as BL33 in the non-secure world (EL2 entry, drops to EL1)
CONFIG_ARMV8_A_NS=y
CONFIG_CACHE_MANAGEMENT=y

# Serial / console
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# SMP, secondaries brought up through TF-A PSCI CPU_ON
CONFIG_SMP=y
CONFIG_MP_MAX_NUM_CPUS=4
CONFIG_PM_CPU_OPS=y
CONFIG_PM_CPU_OPS_PSCI=y
