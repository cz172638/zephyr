 *
 * Globalscale ESPRESSObin (v5, DDR3 1 GiB 2CS). Zephyr is the BL33 of
 * TF-A (PLAT=a3700), loaded at DRAM base. TF-A itself lives at
 * 0x04000000-0x05000000.
 */

#include <freq.h>
#include <marvell/armada3720.dtsi>

/ {
	model = "Globalscale ESPRESSObin";
	compatible = "globalscale,espressobin", "marvell,armada3720";

	chosen {
		zephyr,sram = &ddr0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
	};

	cpus {
		timebase-frequency = <DT_FREQ_M(25)>;
	};

	ddr0: memory@0 {
		device_type = "memory";
		reg = <0x00000000 DT_SIZE_M(64)>;
	};
};

/* micro-USB J5 through the on-board FTDI */
&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

/*
 * eth0 -- RGMII-ID, fixed 1000/full -- 88E6341 port 0 (CPU)
 * 88E6341 at SMI address 1 (multi-chip), ports 1 (wan), 2 (lan0),
 * 3 (lan1). Without DSA tagging all three behave as one interface.
 */
&mdio {
	status = "okay";
	pinctrl-0 = <&mdio_default>;
	pinctrl-names = "default";

	switch0: ethernet-switch@1 {
		compatible = "marvell,mv88e6085";
		reg = <1>;
		marvell,cpu-port = <0>;
		marvell,user-ports = [01 02 03];
	};
};

&eth0 {
	status = "okay";
	pinctrl-0 = <&eth0_default>;
	pinctrl-names = "default";
	phy-connection-type = "rgmii-id";
	phy-handle = <&switch0>;
	/* the board MAC is in the U-Boot environment only */
	zephyr,random-mac-address;
};

/* Boot flash: Winbond W25Q32DW, 4 MiB, 1.8 V */
&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_default>;
	pinctrl-names = "default";

	spi_nor: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(50)>;
		size = <DT_SIZE_M(32)>; /* bits */
		jedec-id = [ef 60 16];

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* TIM + WTMI + TF-A + FIP with Zephyr (mkflash.sh output) */
			boot_partition: partition@0 {
				label = "firmware";
				reg = <0x0 0x3e0000>;
			};

			/* Zephyr settings, kept apart from the U-Boot environment */
			storage_partition: partition@3e0000 {
				label = "zephyr-storage";
				reg = <0x3e0000 0x10000>;
			};

			/* U-Boot environment of the stock/upstream U-Boot */
			env_partition: partition@3f0000 {
				label = "u-boot-env";
				reg = <0x3f0000 0x10000>;
			};
		};
	};
};
