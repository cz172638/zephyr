if BOARD_ESPRESSOBIN

# The SPI NOR boot flash sits behind the SPI controller
configdefault SPI
	default y if FLASH

# 4 KiB sectors: NVS sectors must fit in 16 bits, and the settings
# partition is only 64 KiB
configdefault SPI_NOR_FLASH_LAYOUT_PAGE_SIZE
	default 4096

if NETWORKING

configdefault ETH_DRIVER
	default y

configdefault NET_RX_STACK_SIZE
	default 3072

configdefault NET_TX_STACK_SIZE
	default 3072

configdefault NET_MGMT_EVENT_STACK_SIZE
	default 2048

endif # NETWORKING

endif # BOARD_ESPRESSOBIN
