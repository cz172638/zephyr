config SOC_SERIES_LS1012A
	bool
	select SOC_FAMILY_NXP_LAYERSCAPE

config SOC_LS1012A
	bool
	select SOC_SERIES_LS1012A
	help
	  NXP Layerscape LS1012A

config SOC
	default "ls1012a" if SOC_LS1012A

config SOC_SERIES
	default "ls1012a" if SOC_SERIES_LS1012A
