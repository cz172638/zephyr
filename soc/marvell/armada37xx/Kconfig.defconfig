if SOC_ARMADA3720

config NUM_IRQS
	default 192

# Generic timer runs from the 25 MHz crystal
config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 25000000

config MP_MAX_NUM_CPUS
	default 2 if SMP

# Peripheral clocks are gated after reset; every driver needs the gates
configdefault CLOCK_CONTROL
	default y

config FLASH_SIZE
	default 0

config FLASH_BASE_ADDRESS
	default 0

endif # SOC_ARMADA3720

if SOC_ARMADA3720_CM3

# 16 external interrupts in the WTMI vector table
config NUM_IRQS
	default 16

# SysTick runs from the CM3 clock, measured from the clock tree at boot
config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 200000000

config SYSTEM_CLOCK_HW_CYCLES_PER_SEC_RUNTIME_UPDATE
	default y


config FLASH_SIZE
	default 0

config FLASH_BASE_ADDRESS
	default 0

# The BootROM jumps in with its own stack and interrupt state
config INIT_ARCH_HW_AT_BOOT
	default y

# The DDR tuning runs on the interrupt stack before the kernel (the WTMI
# gave it 4 KiB)
config ISR_STACK_SIZE
	default 4096

endif # SOC_ARMADA3720_CM3
