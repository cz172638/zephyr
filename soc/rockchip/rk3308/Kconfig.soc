config SOC_SERIES_RK3308
	bool
	select SOC_FAMILY_ROCKCHIP

config SOC_RK3308
	bool
	select SOC_SERIES_RK3308

config SOC_SERIES
	default "rk3308" if SOC_SERIES_RK3308

config SOC
	default "rk3308" if SOC_RK3308
