 #define H6_CCM_SPI0_GATE_RESET      (1 << 0 | 1 << 16)
 
+/* A523/A527/T527: H6-style registers, but the CCM lives at 0x02001000 */
+#define A523_CCM_BASE               (0x02001000)
+
 #define SUNIV_GPC_SPI0              (2)
 #define SUNXI_GPC_SPI0              (3)
 #define SUN50I_GPC_SPI0             (4)
@@ -131,6 +134,8 @@ static uint32_t gpio_base(feldev_handle *dev)
 	case 0x1728: /* H6 */
 	case 0x1823: /* H616 */
 		return 0x0300B000;
+	case 0x1890: /* A523 */
+		return 0x02000000;
 	default:
 		return 0x01C20800;
 	}
@@ -151,6 +156,8 @@ static uint32_t spi_base(feldev_handle *dev)
 	case 0x1728: /* H6 */
 	case 0x1823: /* H616 */
 		return 0x05010000;
+	case 0x1890: /* A523 */
+		return 0x04025000;
 	default:
 		return 0x01C68000;
 	}
@@ -192,12 +199,19 @@ static bool soc_is_h6_style(feldev_handle *dev)
 	case 0x1817: /* V831 */
 	case 0x1728: /* H6 */
 	case 0x1823: /* H616 */
+	case 0x1890: /* A523 */
 		return true;
 	default:
 		return false;
 	}
 }
 
+/* Base of the CCU for H6-style SoCs */
+static uint32_t ccm_base(feldev_handle *dev)
+{
+	return dev->soc_info->soc_id == 0x1890 ? A523_CCM_BASE : 0x03001000;
+}
+
 /*
  * Init the SPI0 controller and setup pins muxing.
  */
@@ -259,6 +273,12 @@ static bool spi0_init(feldev_handle *dev)
