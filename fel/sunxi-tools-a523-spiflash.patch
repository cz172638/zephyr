 		/* Choose 24MHz from OSC24M and enable clock */
 		writel(1U << 31,
-		       soc_is_h6_style(dev) ? H6_CCM_SPI0_CLK : CCM_SPI0_CLK);
+		       soc_is_h6_style(dev) ? ccm_base(dev) + 0x940 : CCM_SPI0_CLK);
 	}
 
 	if (spi_is_sun6i(dev)) {
