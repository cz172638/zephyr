menuconfig LAB_AGENT
	bool "Lab agent (test automation between boards, debug builds)"
	depends on NETWORKING && NET_SOCKETS && NET_UDP && NET_IPV4
	depends on SHELL && SHELL_BACKEND_DUMMY
	select SETTINGS
	help
	  A UDP service that lets a peer board run shell commands here,
	  measure the clock offset and send files, plus "lab" shell
	  commands to do the same to the peer. Protected only by a shared
	  token and the peer's address: for a lab segment, not for a
	  network anyone else is on.

if LAB_AGENT

config LAB_IMAGE
	int "Image number of this firmware"
	default 0
	help
	  The number of the firmware image (NNN-name-spi.bin). Modules are
	  built with the same number; lab mod load / lab ext refuse a module
	  built for another image unless forced (-f). Bump it with every
	  change outside the debug modules.

config LAB_PORT
	int "UDP port"
	default 7777

config LAB_PRIORITY
	int "Server thread priority"
	default 10

config LAB_STACK_SIZE
	int "Server thread stack size"
	default 8192

config LAB_EXEC_TIMEOUT
	int "lab exec: seconds to wait for the peer command"
	default 30

config LAB_FILES
	int "RAM file slots"
	default 8

config LAB_FILE_POOL_SIZE
	int "RAM file pool, bytes"
	default 1048576

config LAB_EXT
	bool "Run test extensions (LLEXT) received by PUT"
	default y if LLEXT
	depends on LLEXT

config LAB_MODS
	int "Debug modules loaded at once (lab mod load)"
	default 8
	depends on LAB_EXT

module = LAB
module-str = lab
source "subsys/logging/Kconfig.template.log_config"

endif
