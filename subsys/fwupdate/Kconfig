menuconfig FWUPDATE
	bool "Firmware update into a flash partition"
	depends on (FLASH && FLASH_MAP) || DISK_ACCESS
	imply REBOOT
	help
	  Shell driven update of the boot image in the partition with node
	  label fwupdate_partition (or boot_partition). The image is
	  received into RAM, checked, then erased, written (first erase
	  unit last) and verified.
	  With FWUPDATE_BOOT_DISK the image is the boot area at the start
	  of a disk instead (e.g. eMMC on Rockchip SoCs).

if FWUPDATE

config FWUPDATE_YMODEM
	bool "YMODEM over the shell UART"
	default y
	depends on SHELL
	select CRC
	help
	  "fwupdate ymodem [dry]" receives the image with YMODEM (CRC-16,
	  1 KiB blocks) on the shell's own UART, e.g. with tio (ctrl-t y)
	  or lrzsz sb. "fwupdate xmodem [dry]" does the same with XMODEM or
	  XMODEM-1K (CRC-16, or the 8-bit checksum when the sender answers the
	  NAK that alternates with 'C' after 3 s), e.g. tio, lrzsz sx or a script
	  with an XMODEM library; the image arrives padded to whole blocks.

config FWUPDATE_YMODEM_START_TIMEOUT
	int "Seconds to wait for the sender"
	default 60
	depends on FWUPDATE_YMODEM

config FWUPDATE_YMODEM_RX_BUF_SIZE
	int "Receive buffer between the shell and the YMODEM thread"
	default 4096
	depends on FWUPDATE_YMODEM

config FWUPDATE_TCP
	bool "Raw TCP upload"
	depends on SHELL && NET_SOCKETS && NET_TCP && NET_IPV4
	select CRC
	help
	  "fwupdate tcp [port] [dry]" accepts one TCP connection and takes
	  everything up to EOF as the image, e.g. nc -N <board> 6969 <
	  flash-image.bin. There is no authentication: enable it only on
	  trusted networks; the command has to be started from a shell (UART
	  or SSH) for each update.

config FWUPDATE_TCP_PORT
	int "Default TCP port"
	default 6969
	depends on FWUPDATE_TCP

config FWUPDATE_TCP_ACCEPT_TIMEOUT
	int "Seconds to wait for the connection"
	default 120
	depends on FWUPDATE_TCP

config FWUPDATE_SCP
	bool "scp upload (scp -O image <board>:/fw)"
	default y
	depends on SHELL_SSH_SCP
	select CRC
	help
	  Registers the SSH shell's legacy scp sink: "scp -O image
	  <board>:/fw" writes the image, ":/fw-dry" only receives and checks
	  it. Authenticated by the SSH server (public key or password).

config FWUPDATE_TIM_HEADER
	bool "Require a Marvell TIM header"
	default y if SOC_SERIES_ARMADA37XX
	help
	  Refuse images that do not carry a TIM header ("TIMH" at offset 4),
	  as produced by the Armada 3700 TF-A mrvl_flash target.

config FWUPDATE_DISK
	bool "SATA boot images onto a disk"
	default y if AHCI && FWUPDATE_TIM_HEADER
	depends on DISK_ACCESS
	help
	  An image whose TIM names SATA as the boot device (BOOTDEV=SATA)
	  goes into the GPT partition of the Marvell boot type on the disk
	  FWUPDATE_DISK_NAME (made e.g. by sata-install.sh), header sector
	  invalidated first and written last, then verified. SPI NOR images
	  still go to the flash partition.

config FWUPDATE_DISK_NAME
	string "Disk with the SATA boot partition"
	default "sata0"
	depends on FWUPDATE_DISK

config FWUPDATE_BOOT_DISK
	bool "Boot area at the start of a disk instead of a flash partition"
	depends on DISK_ACCESS
	help
	  With a fwupdate_partition or boot_partition as well, the disk is
	  the target only when that partition's flash device is not ready
	  (a board variant without the SPI NOR); images are told apart by
	  the MBR the disk image starts with.
	  The image is a raw copy of the first FWUPDATE_BOOT_DISK_SIZE bytes
	  of the disk FWUPDATE_BOOT_DISK_NAME (e.g. MBR, Rockchip idbloader
	  at sector 64 and the FIT after it), written from sector 0. The
	  sector the boot ROM checks first (FWUPDATE_BOOT_DISK_HEADER) is
	  zeroed before and written after the rest, then all is verified.

config FWUPDATE_BOOT_DISK_NAME
	string "Disk with the boot area"
	default "EMMC"
	depends on FWUPDATE_BOOT_DISK

config FWUPDATE_BOOT_DISK_SIZE
	hex "Size of the boot area (bytes, also the receive buffer)"
	default 0x1000000
	depends on FWUPDATE_BOOT_DISK

config FWUPDATE_BOOT_DISK_HEADER
	int "Sector with the boot header, written last"
	default 64 if SOC_FAMILY_ROCKCHIP
	default 0
	depends on FWUPDATE_BOOT_DISK

config FWUPDATE_PROGRAM_EXTERNAL
	bool
	select CRC
	help
	  Selected by a platform that programs the image itself
	  (fwupdate_program_external()), e.g. a secure processor owning the
	  flash. The partition still gives the maximum size.

config FWUPDATE_THREAD_STACK_SIZE
	int "Update thread stack size"
	default 2048

config FWUPDATE_THREAD_PRIORITY
	int "Update thread priority"
	default 5

# 1 KiB blocks must not overrun the shell's UART receive ring
configdefault SHELL_BACKEND_SERIAL_RX_RING_BUFFER_SIZE
	default 2048 if FWUPDATE_YMODEM

endif # FWUPDATE
